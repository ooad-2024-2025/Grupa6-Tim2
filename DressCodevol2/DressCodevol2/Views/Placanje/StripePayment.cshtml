@{
    ViewData["Title"] = "Plaćanje - Stripe Payment";
}
@* Stilovi unutar same cshtml datoteke *@
<style>
    body {
        background-color: #fdf6f0;
        color: #4b3621;
        font-family: 'Segoe UI', sans-serif;
    }

    h2 {
        color: #6b4c3b;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .form-control {
        background-color: #fff9f3;
        border: 1px solid #d9bfa3;
        color: #4b3621;
    }

        .form-control::placeholder {
            color: #b79d8d;
        }

    label {
        margin-bottom: 0.5rem;
        color: #6b4c3b;
        font-weight: 500;
    }

    #card-element {
        background-color: #fff9f3;
        border: 1px solid #d9bfa3;
        padding: 10px;
        height: 44px;
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

    #card-errors {
        margin-top: 8px;
        color: #a94442;
        font-size: 0.9rem;
    }

    .btn-primary {
        background-color: #a37551;
        border-color: #a37551;
        color: #fff;
        font-weight: 500;
        border-radius: 4px;
    }

        .btn-primary:hover {
            background-color: #8b5e3c;
            border-color: #8b5e3c;
        }

    #submit-button:disabled {
        background-color: #c2a48a;
        border-color: #c2a48a;
    }

    .payment-container {
        max-width: 500px;
        margin: 3rem auto;
        padding: 2rem;
        background-color: #fff9f3;
        border: 1px solid #e3d2c3;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0,0,0,0.08);
    }
</style>

<div class="payment-container">
    <h2 style="text-align:center;">Unesite podatke za kartično plaćanje</h2>
    <form action="/Placanje/ProcessPayment" method="post" id="payment-form" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false">
        <input type="hidden" name="amount" id="amount" value="@ViewBag.Amount" />

        <div class="mb-3">
            <label for="card-element">Kreditna ili debitna kartica</label>
            <div id="card-element" class="form-control">
                <!-- Stripe Elements će ovdje ubaciti kartični input -->
            </div>
            <div id="card-errors" role="alert"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100" id="submit-button">
            <span id="button-text">Plati</span>
        </button>
    </form>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    var stripe = Stripe('@ViewBag.PublishableKey');
    var elements = stripe.elements();
    var cardElement = elements.create('card', {
        style: {
            base: {
                fontSize: '16px',
                color: '#4b3621',
                backgroundColor: '#fff9f3',
                '::placeholder': {
                    color: '#b79d8d'
                },
                fontFamily: 'Segoe UI, sans-serif'
            },
            invalid: {
                color: '#a94442'
            }
        getCustomCardError}
    });
    cardElement.mount('#card-element');

    cardElement.on('change', ({ error }) => {
        const displayError = document.getElementById('card-errors');
        if (error) {
            displayError.textContent = getCustomCardError(error.code);
        } else {
            displayError.textContent = '';
        }
         elements.update({
            // Postavi prazan postalCode
            value: { postalCode: '' },
            // Onemogući postalCode
            disabled: true
        });
    });

    function getCustomCardError(errorCode) {
        switch (errorCode) {
            case 'incomplete_number': return 'Broj kartice je nepotpun.';
            case 'incomplete_expiry': return 'Datum isteka je nepotpun.';
            case 'incomplete_cvc': return 'CVC kod je nepotpun.';
            case 'invalid_number': return 'Broj kartice nije valjan.';
            case 'invalid_expiry': return 'Datum isteka nije valjan.';
            case 'invalid_expiry_year_past': return 'Kartica je istekla.';
            case 'invalid_cvc': return 'CVC kod nije valjan.';
            case 'card_declined': return 'Kartica je odbijena.';
            default: return 'Došlo je do greške sa karticom.';
        }
    }

    var form = document.getElementById('payment-form');
    var submitButton = document.getElementById('submit-button');
    var buttonText = document.getElementById('button-text');

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        submitButton.disabled = true;
        buttonText.textContent = 'Obrađuje se...';

        const { token, error } = await stripe.createToken(cardElement);
        if (error) {
            document.getElementById('card-errors').textContent = getCustomCardError(error.code);
            submitButton.disabled = false;
            buttonText.textContent = 'Plati';
        } else {
            var hiddenInput = document.createElement('input');
            hiddenInput.setAttribute('type', 'hidden');
            hiddenInput.setAttribute('name', 'stripeToken');
            hiddenInput.setAttribute('value', token.id);
            form.appendChild(hiddenInput);
            form.submit();
        }
    });
</script>
