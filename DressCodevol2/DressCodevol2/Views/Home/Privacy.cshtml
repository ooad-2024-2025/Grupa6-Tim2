@{
    ViewData["Title"] = "O nama";
}

<div class="about-us-section">
    <div class="overlay">
        <div class="content text-center text-white">
            <h1 class="display-3 fw-bold">DressCode</h1>
            <p class="lead mt-4">
                Inovativna platforma za online pregled i kupovinu odjeće i ostalih odjevnih artikala kreirana tako da je kupac uvijek na prvom mjestu.
            </p>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto&display=swap');

    .about-us-section {
        position: relative;
        height: 100vh;
        background-image: url('/images/onama.jpg'); /* <-- promijeni ovo u svoj path do slike */
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        backdrop-filter: blur(5px);
        background-color: rgba(0, 0, 0, 0.4); /* tamni sloj preko slike */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .content {
        max-width: 800px;
        font-family: 'Playfair Display', serif;
    }

        .content h1 {
            font-size: 4rem;
            letter-spacing: 2px;
        }

        .content p {
            font-size: 1.25rem;
            font-family: 'Roboto', sans-serif;
        }
</style>
